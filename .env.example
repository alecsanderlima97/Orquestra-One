# Firebase do Orquestra One (projeto "orquestra-one"). Sistema independente:
# não usa o Firebase do Portal Orquestra.cs. Chaves públicas do app web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=orquestra-one.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=orquestra-one
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1066164242073
NEXT_PUBLIC_FIREBASE_APP_ID=1:1066164242073:web:335d19dad04fb5e4e19a08

# Firebase Admin — manter apenas na Vercel, nunca no navegador ou no Git.
FIREBASE_PROJECT_ID=orquestra-one
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# E-mail Google do dono do sistema (Central Admin). Entra sem convite na primeira vez.
PLATFORM_OWNER_EMAIL=

# Convites e empresas ficam no Firestore do One. O vínculo com o Portal Orquestra.cs
# é só a Central Admin do desenvolvedor.
