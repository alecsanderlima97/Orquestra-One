rules_version = '2';

// Orquestra One — banco próprio. Cada empresa só enxerga os dados da própria empresa.
// users / companies / invitations só são gravados pelo servidor (Admin SDK ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPlatform() {
      return hasProfile() && profile().active == true && profile().role in ['platform_owner', 'orquestra_admin'];
    }

    function inTenant(tenantId) {
      return hasProfile() && profile().active == true && profile().tenantId == tenantId;
    }

    function canWrite(tenantId) {
      return inTenant(tenantId) && profile().role in ['company_owner', 'company_admin', 'company_user'];
    }

    // Cada usuário lê o próprio perfil. Nunca grava pelo navegador.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isPlatform());
      allow write: if false;
    }

    // Empresa: lida pelos membros; criada/alterada só pelo servidor.
    match /companies/{tenantId} {
      allow read: if inTenant(tenantId) || isPlatform();
      allow write: if false;

      // Dados operacionais da empresa (agenda, OS, financeiro, estoque, clientes...).
      match /{collection}/{docId} {
        allow read: if inTenant(tenantId);
        allow create, update, delete: if canWrite(tenantId);
      }
    }

    // Convites: só o servidor lê e grava.
    match /invitations/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
